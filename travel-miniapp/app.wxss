/* ==========================================================================
   花溪旅行 · 小程序设计系统（全局样式）
   --------------------------------------------------------------------------
   视觉基调：黔中山水「青绿 + 纸白 + 一点暖橙」
   - 主色青绿取自花溪河水与喀斯特山林，压深作标题、提亮作强调
   - 大面积留白纸白底，卡片靠 1rpx 描边 + 极浅投影区分层级，不堆重阴影
   - 暖橙只给价格 / 评分 / 提醒，一个页面里出现不超过 3 处
   - 所有尺寸走 4rpx 栅格（8/16/24/32/40/48），圆角只有 4 档 + 胶囊
   命名：t-* 排版 / c-* 组件 / u-* 工具类；页面级样式只写「这页独有」的东西
   ========================================================================== */

page {
  /* 色板 */
  --brand: #2f7d5c;
  --brand-deep: #1f6b4f;
  --brand-mid: #6fb79a;
  --brand-tint: #eaf4ef;
  --brand-tint-2: #f4faf7;
  --accent: #d97734;
  --accent-tint: #fdf1e7;
  --ink: #14211c;
  --body: #3d4a44;
  --muted: #8a9a93;
  --faint: #b7c2bd;
  --line: #e6ede9;
  --line-soft: #f0f4f2;
  --bg: #f4f7f5;
  --surface: #ffffff;
  --ok: #2e9e63;
  --warn: #c77d1e;
  --danger: #c6473a;
  --info: #3e7cb1;

  /* 圆角 */
  --r-sm: 8rpx;
  --r-md: 12rpx;
  --r-lg: 20rpx;
  --r-xl: 28rpx;
  --r-pill: 999rpx;

  /* 间距（4rpx 栅格） */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 40rpx;
  --sp-6: 48rpx;
  --gutter: 24rpx;

  /* 阴影：只用三档，且都很浅 */
  --sh-card: 0 2rpx 10rpx rgba(20, 33, 28, 0.05);
  --sh-raise: 0 10rpx 30rpx rgba(20, 33, 28, 0.12);
  --sh-sheet: 0 -10rpx 36rpx rgba(16, 28, 22, 0.14);
  --sh-brand: 0 8rpx 20rpx rgba(47, 125, 92, 0.24);

  background: var(--bg);
  color: var(--body);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ============================ 1. 排版 ============================ */

.t-h1 { font-size: 48rpx; font-weight: 700; color: var(--ink); line-height: 1.3; }
.t-h2 { font-size: 38rpx; font-weight: 700; color: var(--ink); line-height: 1.35; }
.t-h3 { font-size: 32rpx; font-weight: 700; color: var(--ink); line-height: 1.4; }
.t-h4 { font-size: 28rpx; font-weight: 600; color: var(--ink); line-height: 1.45; }
.t-body { font-size: 28rpx; color: var(--body); }
.t-sm { font-size: 24rpx; color: var(--muted); }
.t-xs { font-size: 20rpx; color: var(--faint); }
.t-num {
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5rpx;
}
.t-brand { color: var(--brand); }
.t-accent { color: var(--accent); }

/* 兼容旧类名（页面里大量使用 .hint / .brand） */
.hint { font-size: 24rpx; color: var(--muted); line-height: 1.6; }
.brand { color: var(--brand); font-weight: 600; }

/* ============================ 2. 容器与卡片 ============================ */

.page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
/* 自定义 tabBar 浮在底部，tab 页要多留出 100rpx */
.page.has-tabbar {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}
.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: var(--sp-4);
  margin: 0 var(--gutter) var(--sp-3);
  box-shadow: var(--sh-card);
}
.card-flat {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: var(--sp-4);
}
.card-tint {
  background: linear-gradient(160deg, var(--brand-tint-2) 0%, var(--surface) 70%);
  border: 1rpx solid #dcebe2;
  border-radius: var(--r-lg);
  padding: var(--sp-4);
  margin: 0 var(--gutter) var(--sp-3);
}
.card-press {
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}
.card-press:active {
  transform: scale(0.985);
  box-shadow: 0 1rpx 4rpx rgba(20, 33, 28, 0.06);
}
.divider {
  height: 1rpx;
  background: var(--line-soft);
  margin: var(--sp-3) 0;
}

/* 区块标题：左侧一条 6rpx 竖杠，比纯文字更有版式感 */
.sec-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: var(--sp-4) var(--gutter) var(--sp-2);
}
.sec-head-tight { margin-top: var(--sp-2); }
.sec-title {
  position: relative;
  padding-left: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}
.sec-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 6rpx;
  width: 6rpx;
  border-radius: var(--r-pill);
  background: linear-gradient(180deg, var(--brand), var(--brand-mid));
}
.sec-sub {
  margin-top: 6rpx;
  padding-left: 18rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.sec-more {
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
  padding: 4rpx 0 4rpx 12rpx;
}

/* ============================ 3. 按钮 ============================ */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 40rpx;
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  border: none;
  box-sizing: border-box;
  transition: transform 0.14s ease, opacity 0.14s ease;
}
.btn::after { border: none; }
.btn:active { transform: scale(0.985); opacity: 0.92; }
.btn-primary {
  background: linear-gradient(135deg, var(--brand) 0%, #3d9470 100%);
  color: #fff;
  box-shadow: var(--sh-brand);
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 600;
}
.btn-primary::after { border: none; }
.btn-ghost {
  background: var(--surface);
  color: var(--brand);
  border: 2rpx solid rgba(47, 125, 92, 0.45);
  border-radius: var(--r-pill);
  font-size: 28rpx;
  font-weight: 600;
}
.btn-ghost::after { border: none; }
.btn-soft {
  background: var(--brand-tint);
  color: var(--brand-deep);
  border-radius: var(--r-pill);
  font-size: 28rpx;
  font-weight: 600;
}
.btn-soft::after { border: none; }
.btn-sm {
  height: 64rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
}
.btn-block { width: 100%; }
.btn[disabled] { opacity: 0.55; }

/* ============================ 4. 标签 / 徽标 ============================ */

.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: var(--r-sm);
  background: #f1f6f3;
  color: #4e7b66;
  font-size: 20rpx;
  line-height: 1;
}
.tag-brand { background: var(--brand-tint); color: var(--brand-deep); }
.tag-accent { background: var(--accent-tint); color: #b4601f; }
.tag-line { background: transparent; border: 1rpx solid var(--line); color: var(--muted); }
.tag-lg { height: 48rpx; padding: 0 20rpx; font-size: 22rpx; border-radius: var(--r-pill); }

/* 筛选胶囊：比 tag 大，可点 */
.chip {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: var(--r-pill);
  background: #f2f6f4;
  color: var(--body);
  font-size: 26rpx;
  border: 2rpx solid transparent;
  transition: all 0.14s ease;
}
.chip.on {
  background: var(--brand-tint);
  color: var(--brand-deep);
  border-color: var(--brand);
  font-weight: 600;
}
.chip-sm { height: 52rpx; padding: 0 20rpx; font-size: 23rpx; }

/* 状态徽标 */
.badge {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: var(--r-pill);
  font-size: 20rpx;
  font-weight: 600;
}
.badge-ok { background: #e7f6ee; color: #24864f; }
.badge-warn { background: #fff2df; color: #9a5a13; }
.badge-danger { background: #fdeceb; color: #b23a2f; }
.badge-info { background: #eaf2fa; color: #2f6c9e; }
.badge-line { background: transparent; border: 1rpx solid var(--line); color: var(--muted); }

/* ============================ 5. 价格 / 评分 / 数字 ============================ */

.price {
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.rating {
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.rating::before { content: '★ '; font-size: 20rpx; }

/* ============================ 6. 媒体 ============================ */

.thumb {
  border-radius: var(--r-md);
  background: #eef3f0;
  overflow: hidden;
  flex: none;
}
.thumb-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 700;
  background: linear-gradient(135deg, #3d9470, var(--brand-deep));
}

/* ============================ 7. 遮罩与底部弹层 ============================ */

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  align-items: flex-end;
  background: rgba(12, 24, 18, 0.46);
  animation: fade-in 0.18s ease-out;
}
.sheet {
  width: 100%;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  background: var(--surface);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  box-shadow: var(--sh-sheet);
  padding-bottom: env(safe-area-inset-bottom);
  animation: sheet-up 0.24s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.sheet-grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: var(--r-pill);
  background: #dfe7e3;
  margin: 16rpx auto 4rpx;
  flex: none;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx var(--sp-4) 8rpx;
  flex: none;
}
.sheet-title { font-size: 32rpx; font-weight: 700; color: var(--ink); }
.sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f2f6f4;
  color: var(--muted);
  font-size: 28rpx;
}
.sheet-body { padding: var(--sp-3) var(--sp-4) var(--sp-4); overflow-y: auto; }

@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ============================ 8. 空态 / 加载 ============================ */

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-1);
  padding: 96rpx var(--sp-5);
  text-align: center;
}
.empty-icon {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--brand-tint);
  font-size: 56rpx;
  margin-bottom: var(--sp-2);
}
.empty-title { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.empty-text { font-size: 24rpx; color: var(--muted); line-height: 1.7; }

.skeleton {
  border-radius: var(--r-md);
  background: linear-gradient(90deg, #eef2f0 25%, #f6f9f7 37%, #eef2f0 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}
@keyframes shimmer {
  from { background-position: 100% 50%; }
  to { background-position: 0 50%; }
}

/* ============================ 9. 工具类 ============================ */

.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.gap-1 { gap: var(--sp-1); }
.gap-2 { gap: var(--sp-2); }
.gap-3 { gap: var(--sp-3); }
.flex-1 { flex: 1; min-width: 0; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
