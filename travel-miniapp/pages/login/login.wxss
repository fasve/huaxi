.auth-page {
  min-height: 100vh;
  padding: 56rpx 0 40rpx;
}
.brand-head {
  text-align: center;
  padding: 0 40rpx 36rpx;
}
.mark { font-size: 72rpx; line-height: 1; margin-bottom: 16rpx; }
.brand-title { font-size: 38rpx; font-weight: 600; margin-bottom: 6rpx; }
.auth-card { padding: 32rpx 28rpx; }
.tabs {
  display: flex;
  background: #f1f4f2;
  border-radius: 44rpx;
  padding: 6rpx;
  margin-bottom: 32rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #909399;
  border-radius: 44rpx;
}
.tab.on {
  background: #fff;
  color: #2f7d5c;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.auth-title { font-size: 36rpx; font-weight: 600; margin-bottom: 4rpx; }
.auth-sub { margin-bottom: 28rpx; }
.field { margin-bottom: 22rpx; }
.label { display: block; font-size: 26rpx; color: #606266; margin-bottom: 10rpx; }
.input {
  background: #fff;
  border: 1rpx solid #e6ebe8;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  min-height: 44rpx;
}
.err-msg {
  background: #fdf0ee;
  color: #b74133;
  font-size: 24rpx;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 20rpx;
}
.submit { margin-top: 12rpx; }
.submit::after { border: none; }
.guest {
  text-align: center;
  color: #2f7d5c;
  font-size: 26rpx;
  padding: 28rpx 0 4rpx;
}
.auth-tip {
  display: block;
  padding: 10rpx 56rpx 0;
  line-height: 1.6;
  text-align: center;
}
