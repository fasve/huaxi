.page { padding: 0 0 48rpx; }
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eef0ef;
  position: sticky;
  top: 0;
  z-index: 5;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: #909399;
  border-bottom: 4rpx solid transparent;
}
.tab.on { color: #2f7d5c; font-weight: 600; border-bottom-color: #2f7d5c; }
.meta { padding: 24rpx 32rpx 8rpx; font-size: 24rpx; color: #909399; }
.sec { background: #fff; border-radius: 16rpx; margin: 20rpx 24rpx; padding: 28rpx 26rpx; }
.sec-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; color: #2f7d5c; }
.p { font-size: 26rpx; line-height: 1.75; color: #4a524e; margin-bottom: 14rpx; }
.p:last-child { margin-bottom: 0; }
.foot {
  margin: 24rpx 32rpx;
  font-size: 22rpx;
  color: #a0a6a2;
  line-height: 1.8;
}
.actions { margin: 32rpx 24rpx 0; }
.actions .btn-primary { margin-bottom: 18rpx; font-size: 30rpx; }
.btn-ghost {
  background: #fff;
  color: #2f7d5c;
  border: 1rpx solid #2f7d5c;
  border-radius: 44rpx;
  font-size: 28rpx;
}
.btn-ghost::after { border: none; }
.tip { display: block; margin-top: 20rpx; line-height: 1.6; }
