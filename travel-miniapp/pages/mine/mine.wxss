.page {
  padding-top: 8rpx;
}

/* ---------- 身份卡 ---------- */
.profile {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: var(--gutter);
  padding: 28rpx;
  border-radius: var(--r-xl);
  background:
    radial-gradient(120% 90% at 100% 0%, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 60%),
    linear-gradient(145deg, #1f6b4f 0%, #2f7d5c 60%, #479b76 100%);
  box-shadow: 0 12rpx 30rpx rgba(20, 63, 45, 0.22);
}
.p-avatar {
  width: 104rpx;
  height: 104rpx;
  flex: none;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.6);
}
.p-info { flex: 1; min-width: 0; }
.p-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}
.p-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.82);
}
.p-quit {
  flex: none;
  padding: 8rpx 20rpx;
  border-radius: var(--r-pill);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  color: #fff;
  font-size: 21rpx;
}

/* ---------- 未登录 ---------- */
.auth { padding: 28rpx; }

/* ---------- 行程列表 ---------- */
.list { padding: 8rpx 24rpx; }
.trip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.trip:last-child { border-bottom: none; }
.trip-main { flex: 1; min-width: 0; }
.trip-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}
.trip-emoji { font-size: 30rpx; }
.trip-name {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--ink);
}
.trip-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}
.trip-spend {
  font-size: 23rpx;
  color: var(--brand-deep);
}
.trip-bar {
  height: 8rpx;
  margin-top: 12rpx;
  border-radius: var(--r-pill);
  background: #eef2f0;
  overflow: hidden;
}
.trip-fill {
  height: 100%;
  border-radius: var(--r-pill);
  background: linear-gradient(90deg, var(--brand-mid), var(--brand));
}
.trip-del {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: var(--r-pill);
  color: #b23a2f;
  font-size: 21rpx;
  background: #fdeceb;
}

/* ---------- 链接 ---------- */
.links { padding: 8rpx 24rpx 20rpx; }
.link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.link:last-of-type { border-bottom: none; }
.link-t {
  font-size: 26rpx;
  color: var(--body);
}
.link-a {
  font-size: 30rpx;
  color: var(--faint);
}
.links-note {
  margin-top: 12rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line-soft);
  font-size: 20rpx;
  line-height: 1.75;
  color: var(--faint);
}
