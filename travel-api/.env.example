# 后端配置模板（复制为 .env 后填入自己的值；.env 已被 .gitignore 忽略）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=travel

API_HOST=0.0.0.0
API_PORT=8000

# ---------- 上线合规 / 生产模式（设计方案 7.x） ----------
# dev（默认）放开 CORS 便于联调；prod 收紧为白名单并下发安全响应头。
# 生产完整模板见 deploy/env/.env.prod.example，自检脚本 scripts/preflight_release.py。
APP_ENV=dev
# prod 必填：逗号分隔的完整 origin，须与备案域名 / 证书 / 微信合法域名一致
CORS_ORIGINS=
PUBLIC_API_ORIGIN=
PORTAL_ORIGIN=
ADMIN_ORIGIN=
CDN_ORIGIN=
ICP_NO=
PRIVACY_CONTACT=

# ---------- 微信登录（设计方案 7.5） ----------
# 小程序注册/微信认证后获得；AppSecret 仅存服务端，严禁写入小程序或前端代码。
# 申请入口：微信公众平台 → 开发管理 → 开发设置。
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_API_BASE=https://api.weixin.qq.com
WECHAT_TIMEOUT_SECONDS=5
WECHAT_MAX_RETRIES=2
# 生产必须 false（走真实 code2session）；仅本地无凭据联调时显式设 true。
MOCK_LOGIN=false
ALLOW_ANONYMOUS_GUEST=true
# 存量过渡：旧版 {id}.{hmac} 自签 token 默认拒绝；确需平滑迁移可临时置 true。
ALLOW_LEGACY_HMAC_TOKEN=false

# ---------- JWT（必须配置，生产用 openssl rand -hex 32 生成） ----------
JWT_SECRET=
JWT_ALG=HS256
JWT_EXPIRE_HOURS=168
JWT_ISSUER=travel-api
JWT_AUDIENCE=travel-client
JWT_LEEWAY_SECONDS=30

FEATURE_ROUTE_API=false
FEATURE_AI_POLISH=false

# 高德开放平台「Web服务」类型 key（仅服务端使用）
# 用途仅限：逆地理编码 / IP 定位（坐标 → 区县地名）。
# 天气数据已全部改用 Open-Meteo（免密钥），不需要任何 key。
# 申请入口：https://console.amap.com/dev/key/app （创建 key 时服务平台选「Web服务」）
AMAP_KEY=请在高德开放平台申请自己的 key 并替换此占位符
# 实时定位失败或未启用时的默认区县（520111 = 贵阳市花溪区）
AMAP_CITY_ADCODE=520111

# ---------- 图片源（联网抓图） ----------
# 抓图会遵循目标站 robots.txt，并用诚实 UA（不伪装浏览器）。
# 图片源优先级：Wikimedia Commons → Openverse → Pixabay → Pexels → 本地占位图。
# 下面两个 key 可留空；也可直接在管理端「系统设置 → 图片来源与授权」里填写，即时生效。
# 申请入口：https://pixabay.com/api/docs/ 与 https://www.pexels.com/api/
PIXABAY_API_KEY=
PEXELS_API_KEY=
# 抓图 bot 的联系方式（会写进 User-Agent，便于站点方联系或协商速率）
IMAGE_BOT_CONTACT=
# Web 图片搜索兜底源：目标站 robots.txt 禁止抓取搜索结果页，默认关闭。
# 仅在离线演示环境临时需要时才设为 true，且开启后仍会做 robots 判定。
IMAGE_ALLOW_WEB_SEARCH=false
