# 微信托管（云托管）环境变量模板
# 填到：云托管控制台 → 服务 → 版本 → 环境变量
# 注意：这些值会注入容器环境，不要提交到仓库。

APP_ENV=prod
API_HOST=0.0.0.0
API_PORT=8000

# ---- MySQL（云托管「数据库 → MySQL」内网地址）----
DB_HOST=10.4.108.35
DB_PORT=3306
DB_USER=root
DB_PASSWORD=V7fTEHqS
DB_NAME=travel

# ---- 认证 ----
# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_HOURS=168
MOCK_LOGIN=false
ALLOW_ANONYMOUS_GUEST=true
ALLOW_LEGACY_HMAC_TOKEN=false
WECHAT_APPID=wx2e16d4a044adc84b
WECHAT_SECRET=

# ---- 站点与跨域（部署后把默认域名填进来）----
PUBLIC_API_ORIGIN=https://travel-api-xxxx.prod-d7gnymd9e909581e8.run.tcloudbase.com
CORS_ORIGINS=https://travel-api-xxxx.run.tcloudbase.com
CDN_ORIGIN=
ICP_NO=
PRIVACY_CONTACT=

# ---- 管理端首次启动账号（务必改）----
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=改成强密码
ADMIN_SESSION_HOURS=12

# ---- 可选功能 ----
FEATURE_QA_CHAT=true
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- 静态资源（图片仍由后端 /static 提供，留空即可）----
