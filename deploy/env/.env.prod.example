# 生产环境变量模板（复制到 travel-api/.env；该文件不得入库、不得下发前端）
# 生成密钥：openssl rand -hex 32
# 自检：python travel-api/scripts/preflight_release.py --strict

# ---------- 运行模式 ----------
APP_ENV=prod
API_HOST=127.0.0.1
API_PORT=8000

# ---------- 站点规划（必须与 ICP 备案 / 证书 / 微信合法域名完全一致） ----------
# 逗号分隔的完整 origin，无尾斜杠；PC 端走同源反代，通常只需 portal 与 admin 两个
CORS_ORIGINS=https://www.example.cn,https://admin.example.cn
PUBLIC_API_ORIGIN=https://api.example.cn
PORTAL_ORIGIN=https://www.example.cn
ADMIN_ORIGIN=https://admin.example.cn
CDN_ORIGIN=https://cdn.example.cn
ICP_NO=黔ICP备00000000号-1
PRIVACY_CONTACT=privacy@example.cn

# ---------- 数据库：独立最小权限账号，禁止 root ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=travel_app
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=travel

# ---------- 微信登录：企业主体小程序，AppSecret 仅存服务端 ----------
# 微信公众平台 → 开发管理 → 开发设置
WECHAT_APPID=CHANGE_ME_WX_APPID
WECHAT_SECRET=CHANGE_ME_WX_APPSECRET
WECHAT_API_BASE=https://api.weixin.qq.com
WECHAT_TIMEOUT_SECONDS=5
WECHAT_MAX_RETRIES=2
MOCK_LOGIN=false
ALLOW_ANONYMOUS_GUEST=true
ALLOW_LEGACY_HMAC_TOKEN=false

# ---------- JWT：轮换后旧 token 全部失效 ----------
JWT_SECRET=CHANGE_ME_OUTPUT_OF_openssl_rand_hex_32
JWT_ALG=HS256
JWT_EXPIRE_HOURS=168
JWT_ISSUER=travel-api
JWT_AUDIENCE=travel-client
JWT_LEEWAY_SECONDS=30

# ---------- 管理端：首账号口令必须改，且建议首账号创建后从环境移除 ----------
ADMIN_BOOTSTRAP_USERNAME=CHANGE_ME_ADMIN_ACCOUNT
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_SESSION_HOURS=12
USER_SESSION_HOURS=168

# ---------- 可选增强（一期全关，提审前保持关闭） ----------
FEATURE_ROUTE_API=false
FEATURE_AI_POLISH=false

# ---------- 第三方服务 ----------
AMAP_KEY=CHANGE_ME_AMAP_WEB_SERVICE_KEY
AMAP_CITY_ADCODE=520111
PIXABAY_API_KEY=
PEXELS_API_KEY=
IMAGE_BOT_CONTACT=ops@example.cn
IMAGE_ALLOW_WEB_SEARCH=false
